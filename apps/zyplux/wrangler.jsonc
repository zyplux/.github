{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zyplux",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "github-hooks.zyplux.ai", "custom_domain": true }],
  "preview_urls": false,
  "secrets": {
    "required": ["ZYPLUX_APP_ID", "ZYPLUX_APP_PRIVATE_KEY", "ZYPLUX_WEBHOOK_SECRET"],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
