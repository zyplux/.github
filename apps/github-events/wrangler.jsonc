{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zyplux-github-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "github-hooks.zyplux.ai", "custom_domain": true }],
  "preview_urls": false,
  "secrets": {
    "required": ["EVENTS_APP_ID", "EVENTS_APP_PRIVATE_KEY", "EVENTS_WEBHOOK_SECRET"],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
