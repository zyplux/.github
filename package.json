{
  "name": "zyplux-github",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "knip": "knip",
    "format": "prettier --write --cache --log-level warn .",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --cache",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run --passWithNoTests",
    "cz": "cz"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@zyplux/cz": "catalog:",
    "@zyplux/eslint-config": "catalog:",
    "@zyplux/tsconfig": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
